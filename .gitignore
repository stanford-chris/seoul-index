# Credentials — never commit the real config
seoul_index_config.json

# Runtime state and generated caches
seoul_index_state.json
seoul_index_state.json.bak-*
sales_agg.json
molit_agg.json
books_agg.json

# Card previews written into the working tree by --dry-run
card_*.png
meth_*.png
weather_card_*.png

# Post archive written before a wipe (public text, but not part of the source)
seoul_index_posts_archive.json

# Python
__pycache__/
*.pyc
*.pyo

# macOS
.DS_Store

# Accumulated crowd readings (cannot be re-fetched, but local to each machine)
crowd_history.jsonl
crowd_history.jsonl.bak-*

# One line per posted card, for skimming output to catch duds (local log)
card_history.jsonl

# One line per posted forecast card (local log)
weather_history.jsonl

# Leftover from an interrupted atomic JSON write (write_json_atomic)
*.json.tmp

# Single-run lock held by seoul_index_post.py for the length of a run
.post.lock

# Single-run lock held by seoul_weather_post.py for the length of a run
.weather.lock

# Timestamped backups written by the deploy script before it edits files
*.predeploy.bak
.gitignore.predeploy.bak

# Label-check verdicts, the rejected ones included (local log)
label_checks.jsonl

# Accumulated Ttareungi readings (Seoul stopped publishing the stock history
# in May 2021, so these cannot be re-fetched either)
bike_history.jsonl
bike_history.jsonl.bak-*

# The four thin feeds (air, weather, river, traffic), accumulated hourly
feeds_history.jsonl
feeds_history.jsonl.bak-*
*.bak-predupe
